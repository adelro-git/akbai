# ─── Supabase (required) ───────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── Claude API (required) ─────────────────────────────────────────
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ─── Circuit Breaker (optional — defaults shown) ───────────────────
# Global daily spend cap in USD
# CIRCUIT_BREAKER_DAILY_CAP_USD=5.0
# Per-user daily spend cap in USD
# CIRCUIT_BREAKER_USER_CAP_USD=0.5
# Warning threshold (0.0–1.0) — triggers warning when spend exceeds this % of cap
# CIRCUIT_BREAKER_WARNING_PCT=0.8

# ─── Sentry (required for production) ─────────────────────────────
# Get from: https://sentry.io/ → Project Settings → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@o0.ingest.sentry.io/0
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=akbai
# Auth token for source map uploads (CI/CD only)
# SENTRY_AUTH_TOKEN=sntrys_...

# ─── PostHog Analytics (required for production) ─────────────────
# Get from: https://us.posthog.com/ → Project Settings → Project API Key
NEXT_PUBLIC_POSTHOG_KEY=phc_your-project-api-key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Personal API Key — server-side only, never expose to client
POSTHOG_PERSONAL_API_KEY=phx_your-personal-api-key

# ─── Xendit Payments (required for payment processing) ──────────
# Get from: https://dashboard.xendit.co/ → Settings → API Keys
XENDIT_SECRET_KEY=xnd_development_...
# Webhook callback verification token (set in Xendit dashboard)
XENDIT_WEBHOOK_SECRET=your-xendit-webhook-callback-token

# ─── Meta Webhook (optional — needed for Meta App Review) ────────
# Random string used for webhook verification handshake
META_WEBHOOK_VERIFY_TOKEN=your-random-verify-token

# ─── Admin Dashboard (required for /admin access) ──────────────────
# Email address that can access the admin dashboard at /admin
ADMIN_EMAIL=your-admin@email.com

# ─── Custom SMTP (optional — Supabase default used if not set) ────
# Follow setup guide: akbai-delivery/skills/devops-engineer/references/smtp-setup-guide.md
# RESEND_API_KEY=re_xxxxx
# SMTP_FROM_EMAIL=noreply@akbai.ph

# ─── Push Notifications (required for push delivery) ────────────────
# Generate VAPID keys: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:push@akbai.ph
