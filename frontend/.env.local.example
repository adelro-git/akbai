# ─── Supabase (required) ───────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── Claude API (required) ─────────────────────────────────────────
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ─── Circuit Breaker (optional — defaults shown) ───────────────────
# Global daily spend cap in USD
# CIRCUIT_BREAKER_DAILY_CAP_USD=5.0
# Per-user daily spend cap in USD
# CIRCUIT_BREAKER_USER_CAP_USD=0.5
# Warning threshold (0.0–1.0) — triggers warning when spend exceeds this % of cap
# CIRCUIT_BREAKER_WARNING_PCT=0.8

# ─── Sentry (required for production) ─────────────────────────────
# Get from: https://sentry.io/ → Project Settings → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@o0.ingest.sentry.io/0
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=akbai
# Auth token for source map uploads (CI/CD only)
# SENTRY_AUTH_TOKEN=sntrys_...

# ─── PostHog Analytics (required for production) ─────────────────
# Get from: https://us.posthog.com/ → Project Settings → Project API Key
NEXT_PUBLIC_POSTHOG_KEY=phc_your-project-api-key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Personal API Key — server-side only, never expose to client
POSTHOG_PERSONAL_API_KEY=phx_your-personal-api-key

# ─── Xendit Payments (required for payment processing) ──────────
# Get from: https://dashboard.xendit.co/ → Settings → API Keys
XENDIT_SECRET_KEY=xnd_development_...
# Webhook callback verification token (set in Xendit dashboard)
XENDIT_WEBHOOK_SECRET=your-xendit-webhook-callback-token

# ─── Meta Webhook (optional — needed for Meta App Review) ────────
# Random string used for webhook verification handshake
META_WEBHOOK_VERIFY_TOKEN=your-random-verify-token

# ─── Admin Dashboard (required for /admin access) ──────────────────
# Email address that can access the admin dashboard at /admin
ADMIN_EMAIL=your-admin@email.com

# ─── Custom SMTP (optional — Supabase default used if not set) ────
# Follow setup guide: akbai-delivery/skills/devops-engineer/references/smtp-setup-guide.md
# RESEND_API_KEY=re_xxxxx
# SMTP_FROM_EMAIL=noreply@akbai.ph

# ─── Push Notifications (required for push delivery) ────────────────
# Generate VAPID keys: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:push@akbai.ph

# ─── Cron (required for scheduled jobs) ─────────────────────────────
# Shared secret for the daily deadline-notification cron
# (/api/cron/deadline-notifications, scheduled in vercel.json).
# Vercel Cron sends this automatically as `Authorization: Bearer $CRON_SECRET`
# once you add it as a Project Environment Variable. Generate a long random
# value, e.g. `openssl rand -hex 32`. The route fails closed (401) if unset.
CRON_SECRET=your-long-random-cron-secret

# ─── Demo / Reviewer Access (Sprint 18, Gap §11 — App Store + Play review) ──
# AKBai's only login is email OTP, which store reviewers cannot receive. These
# vars enable a single seeded demo account (demo@akbai.app) to sign in via
# /api/demo-login WITHOUT the email round-trip.
#
# SECURITY — FAIL-CLOSED. Leave ALL THREE UNSET in normal production builds.
#   When DEMO_MODE_ENABLED is unset/!= 'true', /api/demo-login returns 404 and
#   no demo sign-in is possible. The OTP/magic-link flow is unaffected.
#   Set these ONLY in the build/env you submit to Apple/Google for review.
#
# DEMO_MODE_ENABLED (server-only) — master switch. Must be exactly 'true' for
#   the demo route to do anything. THIS is the real enforcement.
# DEMO_MODE_ENABLED=true
#
# NEXT_PUBLIC_DEMO_MODE (public) — cosmetic: shows the "Demo (para sa reviewer)"
#   button on the login page. No security value on its own; the server flag
#   above is what gates sign-in. Set to 'true' in review builds so reviewers
#   can find the button.
# NEXT_PUBLIC_DEMO_MODE=true
#
# DEMO_ACCOUNT_PASSWORD (server-only) — the demo account's real Supabase
#   password. MUST match the value passed to seed-demo-account.sql
#   (-v demo_password='...'). Use a strong, unique value. Give reviewers
#   demo@akbai.app + this password in the App Store / Play review notes.
# DEMO_ACCOUNT_PASSWORD=change-me-strong-demo-password
